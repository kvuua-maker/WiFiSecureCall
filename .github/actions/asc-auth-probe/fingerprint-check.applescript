-- App Store Connect key check. Opens a file chooser, then reports three things only:
--   MATCH=true|false   the public key digest, against the one the GitHub secret holds
--   HTTP=<code>        what App Store Connect answers to a request signed with this file
--   Apple own error text
-- The file is only read. Nothing is written, replaced or uploaded anywhere.

set theFile to choose file with prompt "Choose the ORIGINAL AuthKey_62TCR6LG4Y.p8 downloaded from App Store Connect"
set thePath to POSIX path of theFile

set theScript to "#!/bin/bash\n# Reads one App Store Connect AuthKey .p8 and reports three things only:\n#   MATCH=true|false   the public key digest against the one the GitHub secret holds\n#   HTTP=<code>        the answer from App Store Connect to a request signed with this file\n#   Apple's own error text\n# The key and the token are never printed.\n\nKEY=\"$1\"\nEXPECTED_DIGEST='00b007e39e7fd3505fb3abcee31731b1dda842b032bdc344ba34dc54816592f9'\nKEY_ID='62TCR6LG4Y'\nISSUER_ID='54ef353e-06cf-40e5-a6a2-176655627032'\n\nif [ ! -r \"$KEY\" ]; then\n  echo 'MATCH=false'\n  echo 'HTTP=not attempted'\n  echo 'ERROR:the chosen file cannot be read'\n  exit 0\nfi\n\nif ! openssl pkey -in \"$KEY\" -noout >/dev/null 2>&1; then\n  echo 'MATCH=false'\n  echo 'HTTP=not attempted'\n  echo 'ERROR:the chosen file is not a readable private key'\n  exit 0\nfi\n\n# The digest of the DER public key, which is what the GitHub side computed. Hashing the armour text\n# instead would give a different value, so the public key is decoded out of it first. The last field\n# of the digest output is the digest itself, whichever format this openssl writes.\ndigest=\"$(openssl pkey -in \"$KEY\" -pubout -outform DER 2>/dev/null | openssl dgst -sha256 | awk '{ print $NF }')\"\nif [ \"$digest\" = \"$EXPECTED_DIGEST\" ]; then\n  echo 'MATCH=true'\nelse\n  echo 'MATCH=false'\nfi\n\nif ! command -v python3 >/dev/null 2>&1; then\n  echo 'HTTP=not attempted'\n  echo 'ERROR:python3 is not available, so no request could be signed'\n  exit 0\nfi\n\nwork=\"$(mktemp -d)\"\ntrap 'rm -rf \"$work\"' EXIT\n\n# Kept in a file rather than in a heredoc inside a command substitution, which is the one construct\n# here that behaves differently under the bash 3.2 that macOS ships.\ncat > \"$work/mint.py\" <<'PYTHON'\nimport base64\nimport json\nimport subprocess\nimport sys\nimport time\n\nkey_path, key_id, issuer_id, work = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]\n\n\ndef b64url(raw):\n    return base64.urlsafe_b64encode(raw).decode().rstrip(\"=\")\n\n\ndef compact(value):\n    return json.dumps(value, separators=(\",\", \":\"))\n\n\nissued = int(time.time())\nheader = b64url(compact({\"alg\": \"ES256\", \"kid\": key_id, \"typ\": \"JWT\"}).encode())\npayload = b64url(compact({\n    \"iss\": issuer_id,\n    \"iat\": issued,\n    \"exp\": issued + 1200,\n    \"aud\": \"appstoreconnect-v1\",\n}).encode())\nsigning_input = f\"{header}.{payload}\"\n\nmessage = f\"{work}/message\"\nsignature = f\"{work}/signature.der\"\nwith open(message, \"wb\") as handle:\n    handle.write(signing_input.encode())\nsubprocess.run(\n    [\"openssl\", \"dgst\", \"-sha256\", \"-sign\", key_path, \"-out\", signature, message],\n    check=True,\n)\nder = open(signature, \"rb\").read()\n\n# ES256 carries the bare r and s values, while openssl emits a DER sequence of two integers. Each\n# integer is 32 bytes, with a leading zero byte when its top bit is set, so each is padded back down.\nindex = 2 if der[1] < 0x80 else 2 + (der[1] & 0x7F)\nparts = []\nfor _ in range(2):\n    length = der[index + 1]\n    parts.append(der[index + 2:index + 2 + length].rjust(32, b\"\\x00\")[-32:])\n    index += 2 + length\n\nsys.stdout.write(signing_input + \".\" + b64url(b\"\".join(parts)))\nPYTHON\n\ntoken=\"$(python3 \"$work/mint.py\" \"$KEY\" \"$KEY_ID\" \"$ISSUER_ID\" \"$work\")\"\nif [ -z \"$token\" ]; then\n  echo 'HTTP=not attempted'\n  echo 'ERROR:the token could not be built from this key'\n  exit 0\nfi\n\nstatus=\"$(curl --silent --max-time 30 --output \"$work/answer.json\" --write-out '%{http_code}' \\\n  --header \"Authorization: Bearer $token\" \\\n  'https://api.appstoreconnect.apple.com/v1/apps?limit=1')\"\necho \"HTTP=$status\"\n\n# Only Apple's own error text, and only when it is the JSON envelope. Anything else is reported by\n# kind so that no page of HTML can end up on screen.\npython3 - \"$work/answer.json\" <<'PYTHON'\nimport json\nimport sys\n\ntry:\n    with open(sys.argv[1]) as handle:\n        errors = json.load(handle).get(\"errors\", [])\nexcept Exception:\n    print(\"ERROR:the answer from App Store Connect was not the expected JSON\")\n    raise SystemExit(0)\n\nif not errors:\n    print(\"no error text was returned\")\n    raise SystemExit(0)\n\nfor error in errors:\n    print(f\"Apple said [{error.get('code', '?')}]: {error.get('title', '')}\")\n    if error.get(\"detail\"):\n        print(f\"  {error['detail']}\")\nPYTHON"

return do shell script theScript & " " & quoted form of thePath